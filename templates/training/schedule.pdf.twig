<!doctype html><html lang="de"><head><meta charset="utf-8"><style>body{font-family:DejaVu Sans,sans-serif;color:#333}h1{color:#00a2d8}table{width:100%;border-collapse:collapse}th,td{padding:7px;border:1px solid #bbb;text-align:left;font-size:9pt}</style></head><body><h1>KuTaWerk – aktuelle Trainingszeiten</h1><table><thead><tr><th>Tag</th><th>Zeit</th><th>Kurs / Stil</th><th>Altersgruppe</th><th>Location</th><th>Trainer</th></tr></thead><tbody>{% set days={1:'Montag',2:'Dienstag',3:'Mittwoch',4:'Donnerstag',5:'Freitag',6:'Samstag',7:'Sonntag'} %}{% for s in sessions %}<tr><td>{{ days[s.weekday] }}</td><td>{{ s.startsAt|date('H:i') }}–{{ s.endsAt|date('H:i') }}</td><td>{{ s.course.name }}{% if s.danceStyle %}<br>{{ s.danceStyle }}{% endif %}</td><td>{{ s.course.ageGroup }}</td><td>{{ s.location.name }}{% if s.location.address %}<br>{{ s.location.address }}{% endif %}</td><td>{% if s.course.trainers is not empty %}{% for t in s.course.trainers %}{{ t.displayName }}{% if not loop.last %}, {% endif %}{% endfor %}{% else %}{{ s.legacyTrainerNames }}{% endif %}</td></tr>{% endfor %}</tbody></table><p>Erzeugt am {{ 'now'|date('d.m.Y H:i') }}</p></body></html>
