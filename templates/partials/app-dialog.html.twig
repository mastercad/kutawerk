<div class="app-dialog-backdrop" data-app-dialog-backdrop hidden>
    <section class="app-dialog" role="dialog" aria-modal="true" aria-labelledby="app-dialog-title" aria-describedby="app-dialog-message" tabindex="-1">
        <button class="app-dialog-close" type="button" data-app-dialog-cancel aria-label="Dialog schließen">×</button>
        <div class="app-dialog-icon" data-app-dialog-icon aria-hidden="true">!</div>
        <div class="app-dialog-copy">
            <h2 id="app-dialog-title" data-app-dialog-title></h2>
            <p id="app-dialog-message" data-app-dialog-message></p>
            <label class="app-dialog-field" data-app-dialog-field hidden><span data-app-dialog-label></span><input type="text" data-app-dialog-input></label>
        </div>
        <div class="app-dialog-actions">
            <button class="button secondary" type="button" data-app-dialog-cancel>Abbrechen</button>
            <button class="button app-dialog-confirm" type="button" data-app-dialog-confirm>Bestätigen</button>
        </div>
    </section>
</div>
