{% extends 'base.html.twig' %}{% block stylesheets %}<link rel="stylesheet" href="{{ asset('styles/admin.css') }}">{% endblock %}{% block body %}<section class="admin-shell narrow"><h1>Anmelden</h1>{% for message in app.flashes('success') %}<p class="success">{{ message }}</p>{% endfor %}{% if error %}<p class="alert">{{ error.messageKey|trans(error.messageData,'security') }}</p>{% endif %}<form method="post" class="admin-form"><input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}"><label>E-Mail<input type="email" name="_username" required autofocus></label><label>Passwort<input type="password" name="_password" required></label><button class="button">Anmelden</button></form></section>{% endblock %}
