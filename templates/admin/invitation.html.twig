{% extends 'base.html.twig' %}{% block stylesheets %}<link rel="stylesheet" href="{{ asset('styles/admin.css') }}">{% endblock %}{% block body %}<section class="admin-shell narrow"><h1>Einladung annehmen</h1><p>Hallo {{ invitation.user.displayName }}, bitte lege dein Passwort fest.</p>{% if error %}<p class="alert">{{ error }}</p>{% endif %}<form method="post" class="admin-form"><input type="hidden" name="_token" value="{{ csrf_token('invitation-' ~ token) }}"><label>Passwort<input type="password" name="password" minlength="12" required></label><label>Passwort wiederholen<input type="password" name="password_repeat" minlength="12" required></label><button class="button">Konto aktivieren</button></form></section>{% endblock %}
