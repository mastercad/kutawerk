{% extends 'base.html.twig' %}{% block stylesheets %}<link rel="stylesheet" href="{{ asset('styles/admin.css') }}">{% endblock %}{% block body %}<section class="admin-shell narrow"><h1>Passwort ändern</h1>{% if error %}<p class="alert">{{ error }}</p>{% endif %}<form method="post" class="admin-form"><input type="hidden" name="_token" value="{{ csrf_token('password-change') }}"><label>Aktuelles Passwort<input type="password" name="current_password" required autocomplete="current-password"></label><label>Neues Passwort<input type="password" name="password" minlength="12" required autocomplete="new-password"></label><label>Wiederholen<input type="password" name="password_repeat" minlength="12" required autocomplete="new-password"></label><button class="button">Passwort ändern</button></form></section>{% endblock %}
