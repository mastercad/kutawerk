<article class="contact-person-card">
    <img src="{{ asset(person.trainerImagePath ?: 'media/trainer-placeholder.svg') }}" alt="{{ person.displayName }}">
    <div><h2>{{ person.displayName }}</h2>{% if person.contactFunction %}<p>{{ person.contactFunction }}</p>{% endif %}</div>
    {% if linked %}<a class="action-link" href="{{ path('contact_person', {id: person.id}) }}">Kontakt aufnehmen</a>{% endif %}
</article>
