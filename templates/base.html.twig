<!doctype html><html lang="de-DE"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="index, follow, archive"><meta name="description" content="Kultur- und Tanzwerkstatt e.V. in Freital"><title>{% block title %}Willkommen bei der Kultur- und Tanzwerkstatt e.V.{% endblock %}</title><link rel="icon" href="{{ asset('favicon.ico') }}" sizes="32x32"><link rel="stylesheet" href="{{ asset('styles/site.css') }}?v=20260905-10"><link rel="stylesheet" href="{{ asset('styles/gallery.css') }}?v=20260904-5"><link rel="stylesheet" href="{{ asset('styles/consent.css') }}?v=20260904-1"><link rel="stylesheet" href="{{ asset('styles/dialog.css') }}?v=20260905-1">{% block stylesheets %}{% endblock %}{% if app.request.pathInfo starts with '/editor' or app.request.pathInfo starts with '/password' %}<link rel="stylesheet" href="{{ asset('styles/admin-refinements.css') }}?v=20260904-4"><link rel="stylesheet" href="{{ asset('styles/wysiwyg.css') }}?v=20260904-4">{% endif %}{% if app.user and app.request.query.has('preview_date') %}<link rel="stylesheet" href="{{ asset('styles/preview.css') }}?v=20260904-4">{% endif %}<script src="{{ asset('scripts/site.js') }}?v=20260905-8" defer></script><script src="{{ asset('scripts/gallery.js') }}?v=20260904-4" defer></script><script src="{{ asset('scripts/consent.js') }}?v=20260905-2" defer></script><script src="{{ asset('scripts/dialog.js') }}?v=20260905-1" defer></script>{% block javascripts %}{% endblock %}</head><body>{% set current=app.request.pathInfo %}<div class="site">
<header class="site-header"><div class="site-hero"><span class="site-hero-slide is-visible" aria-hidden="true"></span><span class="site-hero-slide" aria-hidden="true"></span><a href="{{ path('home') }}"><img src="{{ asset('media/site-logo.png') }}" alt="KuTaWerk – Kultur- und Tanzwerkstatt e.V."></a></div><button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-navigation">Menü</button><nav class="main-navigation" id="main-navigation" aria-label="Hauptnavigation"><a class="{{ current=='/'?'active' }}" href="{{ path('home') }}">HOME</a><a class="{{ current starts with '/news'?'active' }}" href="{{ path('news_index') }}">NEWS</a><a class="{{ current starts with '/about-us'?'active' }}" href="{{ path('about') }}">ÜBER UNS</a><a class="{{ current starts with '/areas'?'active' }}" href="{{ path('area_index') }}">BEREICHE</a><a class="{{ current starts with '/contact'?'active' }}" href="{{ path('contact_index') }}">KONTAKT</a></nav>
{% if current starts with '/about-us' %}<nav class="sub-navigation"><a class="{{ current=='/about-us/downloads'?'active' }}" href="{{ path('about_downloads') }}">Downloads</a></nav>{% endif %}{% if current starts with '/areas' %}<nav class="sub-navigation"><a class="{{ current starts with '/areas/dance'?'active' }}" href="{{ path('dance_index') }}">Tanz</a><a class="{{ current=='/areas/culture'?'active' }}" href="{{ path('area_culture') }}">Kultur</a><a class="{{ current=='/areas/technology'?'active' }}" href="{{ path('area_technology') }}">Technik</a><a class="{{ current starts with '/areas/kuta-lounge'?'active' }}" href="{{ path('lounge_index') }}">KuTa Lounge</a></nav>{% if current starts with '/areas/dance' %}<nav class="sub-navigation secondary"><a class="{{ current==path('dance_trainers')?'active' }}" href="{{ path('dance_trainers') }}"{% if current==path('dance_trainers') %} aria-current="page"{% endif %}>Trainer</a><a class="{{ current==path('dance_schedule')?'active' }}" href="{{ path('dance_schedule') }}"{% if current==path('dance_schedule') %} aria-current="page"{% endif %}>Trainingszeiten</a><a class="{{ current==path('dance_dates')?'active' }}" href="{{ path('dance_dates') }}"{% if current==path('dance_dates') %} aria-current="page"{% endif %}>Termine</a><a class="{{ current==path('dance_contract')?'active' }}" href="{{ path('dance_contract') }}"{% if current==path('dance_contract') %} aria-current="page"{% endif %}>Vertrag</a></nav>{% elseif current starts with '/areas/kuta-lounge' %}<nav class="sub-navigation secondary"><a href="{{ path('lounge_rental') }}">Vermietung</a></nav>{% endif %}{% endif %}{% if current starts with '/contact' %}{% include 'partials/contact-navigation.html.twig' %}{% endif %}</header>
<main class="site-content">{% if app.user and app.request.query.has('preview_date') %}<aside class="preview-banner"><strong>Geschützte Vorschau für {{ app.request.query.get('preview_date')|date('d.m.Y') }}</strong><span>Nur angemeldete Redakteure sehen diesen zukünftigen Stand.</span><a href="{{ app.request.pathInfo }}">Vorschau beenden</a></aside>{% endif %}{% block body %}{% endblock %}</main>
<footer class="site-footer"><div class="footer-columns"><section class="footer-contact"><h2><a href="{{ path('contact_index') }}">KONTAKT</a></h2><p>Kultur- und Tanzwerkstatt e.V.<br>Dresdner Straße 357<br>01705 Freital</p><p>E-Mail: <a href="mailto:info@kutawerk.de">info@kutawerk.de</a></p><div class="social-icons"><a href="https://www.facebook.com/Kutawerk/" target="_blank" rel="noopener noreferrer"><img src="{{ asset('media/facebook.png') }}" alt="Facebook"></a><a href="https://www.instagram.com/kutawerk/" target="_blank" rel="noopener noreferrer"><img src="{{ asset('media/instagram.png') }}" alt="Instagram"></a></div></section><section class="footer-center"><img class="footer-brand-image" src="{{ asset('media/footer-logo.png') }}" alt="KuTaWerk"><a href="https://www.so-geht-saechsisch.de/" target="_blank" rel="noopener noreferrer"><img class="footer-partner-image" src="{{ asset('media/so-geht-saechsisch.png') }}" alt="So geht sächsisch"></a><p><a href="{{ path('about_downloads') }}"><strong>Downloads</strong></a></p></section><section class="footer-member"><p>Wir sind Mitglied im</p><a href="http://www.soziokultur-freital.de/" target="_blank" rel="noopener noreferrer"><img class="footer-partner-image" src="{{ asset('media/mitglied-logo.png') }}" alt="Soziokultur Freital"></a></section><section class="footer-youth"><p>Anerkannt als <strong>Träger der freien Jugendhilfe</strong> im Landkreis Sächsische Schweiz-Osterzgebirge, seit 2008.</p></section></div><nav class="legal-navigation"><a href="{{ path('legal_imprint') }}">Impressum</a><a href="{{ path('legal_privacy') }}">Datenschutz</a><a href="{{ path('legal_cookies') }}">Cookie-Richtlinie</a><a href="{{ path('legal_cookies') }}" data-cookie-settings>Cookie-Einstellungen</a><a class="withdrawal-link" href="{{ path('legal_withdrawal') }}">Vertrag widerrufen</a><a href="{{ app.user?path('editor_dashboard'):path('app_login') }}">Redaktion</a></nav></footer></div>{% include 'partials/cookie-consent.html.twig' %}{% include 'partials/app-dialog.html.twig' %}</body></html>
