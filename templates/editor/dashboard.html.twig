{% extends 'base.html.twig' %}{% block stylesheets %}<link rel="stylesheet" href="{{ asset('styles/admin.css') }}">{% endblock %}
{% block body %}<section class="admin-shell">{% include 'editor/_nav.html.twig' %}<main class="admin-content"><header class="admin-page-header"><div><span class="eyebrow">Übersicht</span><h1>Hallo {{ app.user.firstName }}</h1><p>Was möchten Sie heute auf der Webseite bearbeiten?</p></div></header>{% for message in app.flashes('success') %}<p class="success">{{ message }}</p>{% endfor %}
<section class="quick-actions" aria-label="Schnellzugriff">{% if is_granted('ROLE_ADMIN') %}<a href="{{ path('editor_users') }}"><strong>{{ userCount }}</strong><span>aktive Benutzer</span><small>Benutzer verwalten →</small></a><a href="{{ path('editor_courses') }}"><strong>{{ courseCount }}</strong><span>aktive Kurse</span><small>Kurse verwalten →</small></a><a href="{{ path('editor_locations') }}"><strong>{{ locationCount }}</strong><span>Trainingsorte</span><small>Orte verwalten →</small></a>{% endif %}{% if is_granted('ROLE_ADMIN') or app.user.hasPermission(constant('App\\Entity\\User::PERMISSION_TRAINING')) %}<a href="{{ path('editor_training_times') }}"><strong>{{ sessionCount }}</strong><span>Trainingszeiten</span><small>Wochenplan bearbeiten →</small></a>{% endif %}</section>
<section class="help-card preview-tool"><h2>Zukünftigen Stand prüfen</h2><p>Wählen Sie ein Datum. Die Vorschau ist nur für angemeldete Benutzer sichtbar.</p><form method="get" class="preview-form"><label>Webseite anzeigen für den <input type="date" name="preview_date" required value="{{ 'tomorrow'|date('Y-m-d') }}"></label><div class="admin-actions"><button class="button secondary" formaction="{{ path('news_index') }}">News prüfen</button><button class="button secondary" formaction="{{ path('dance_schedule') }}">Trainingsplan prüfen</button><button class="button secondary" formaction="{{ path('dance_dates') }}">Termine prüfen</button></div></form></section><section class="help-card"><h2>So funktioniert die Redaktion</h2><ol><li>Wählen Sie links den Bereich aus, den Sie bearbeiten möchten.</li><li>Klicken Sie auf „Anlegen“ oder bei einem vorhandenen Eintrag auf „Bearbeiten“.</li><li>Prüfen Sie Ihre Angaben und speichern Sie erst danach.</li></ol><p>Einträge werden beim Deaktivieren nicht endgültig vernichtet. Sie können später wieder bearbeitet und aktiviert werden.</p></section></main></section>{% endblock %}
