{% extends 'base.html.twig' %}{% block stylesheets %}<link rel="stylesheet" href="{{ asset('styles/admin.css') }}">{% endblock %}{% block javascripts %}<script src="{{ asset('scripts/admin.js') }}?v=20260905-11" defer></script>{% endblock %}
{% block body %}<section class="admin-shell">{% include 'editor/_nav.html.twig' %}<main class="admin-content"><header class="admin-page-header"><div><span class="eyebrow">Inhalte</span><h1>Termine</h1><p>Termine vorbereiten und zeitgesteuert veröffentlichen.</p></div><button class="button editor-create" data-create-title="Termin anlegen">Termin anlegen</button></header>{% for message in app.flashes('success') %}<p class="success">{{ message }}</p>{% endfor %}{% for message in app.flashes('error') %}<p class="alert">{{ message }}</p>{% endfor %}
<form method="post" class="admin-form event-form editor-panel" data-editor-form="events" hidden><input type="hidden" name="_token" value="{{ csrf_token('event-save') }}"><input type="hidden" name="id"><input type="hidden" name="original_date_label"><h2 class="editor-form-title wide">Termin anlegen</h2><label class="wide">Was findet statt?<input name="title" required></label><label>Veranstaltungsdatum<input type="date" name="date" required></label><label>Uhrzeit<input type="time" name="time"></label><label>Auf der Webseite anzeigen ab<input type="datetime-local" name="visible_from"><small>Leer lassen: sofort.</small></label><label>Auf der Webseite anzeigen bis<input type="datetime-local" name="visible_until"><small>Leer lassen: automatisch unbegrenzt.</small></label><label>Wo findet es statt?<input name="location" list="known-locations"><datalist id="known-locations">{% for l in locations %}<option value="{{ l.name }}">{{ l.address }}</option>{% endfor %}</datalist></label><label>Bereich<select name="department" required>{% for d in departments %}<option value="{{ d.id }}">{{ d.name }}</option>{% endfor %}</select></label><label>Kurs (optional)<select name="course"><option value="">Keinem Kurs zuordnen</option>{% for c in courses %}<option value="{{ c.id }}">{{ c.name }}</option>{% endfor %}</select></label><label class="wide">Beschreibung<textarea name="description"></textarea></label><label class="wide">Weiterführender Link<input type="url" name="link"></label><div class="choice-group"><label><input type="checkbox" name="active" value="1" checked><span>Termin zur Anzeige freigeben</span></label></div><div class="admin-actions wide"><button class="button">Termin speichern</button><button class="button secondary editor-cancel" type="button">Abbrechen</button></div></form>
<section class="admin-list-section"><header class="list-heading"><div><h2>Vorhandene Termine</h2><p>{{ events|length }} Termine</p></div></header><div class="admin-event-list">{% for e in events %}<article><div class="record-main"><span class="record-date"><strong>{{ e.date|date('d') }}</strong><small>{{ e.date|date('m.Y') }}</small></span><div><strong>{{ e.title }}</strong><p>{{ e.date|date('d.m.Y') }}{% if e.time %} um {{ e.time|date('H:i') }} Uhr{% endif %}{% if e.location %} · {{ e.location }}{% endif %}</p><div class="record-meta"><span class="status {{ e.date < today or not e.visibleAt ? 'inactive' : 'active' }}">{{ e.date < today ? 'Termin vorbei' : (e.visibleAt ? 'Jetzt sichtbar' : (e.active ? 'Veröffentlichung geplant oder beendet' : 'Ausgeblendet')) }}</span>{% if e.visibleFrom %}<span>Anzeige ab {{ e.visibleFrom|date('d.m.Y H:i') }}</span>{% endif %}{% if e.visibleUntil %}<span>bis {{ e.visibleUntil|date('d.m.Y H:i') }}</span>{% endif %}</div></div></div><div class="admin-actions"><button type="button" class="button secondary editor-edit" data-edit-title="Termin bearbeiten" data-id="{{ e.id }}" data-title="{{ e.title|e('html_attr') }}" data-date="{{ e.date|date('Y-m-d') }}" data-time="{{ e.time ? e.time|date('H:i') : '' }}" data-visible-from="{{ e.visibleFrom ? e.visibleFrom|date('Y-m-d\\TH:i') : '' }}" data-visible-until="{{ e.visibleUntil ? e.visibleUntil|date('Y-m-d\\TH:i') : '' }}" data-original-date-label="{{ e.originalDateLabel|e('html_attr') }}" data-location="{{ e.location|e('html_attr') }}" data-department="{{ e.department.id }}" data-course="{{ e.course ? e.course.id : '' }}" data-description="{{ e.description|e('html_attr') }}" data-link="{{ e.link|e('html_attr') }}" data-active="{{ e.active ? '1' : '0' }}">Bearbeiten</button><form method="post" action="{{ path('editor_delete_event',{id:e.id}) }}" class="inline-form" data-confirm="Der Termin wird von der Webseite genommen." data-confirm-title="Termin ausblenden?" data-confirm-action="Nicht mehr anzeigen"><input type="hidden" name="_token" value="{{ csrf_token('event-delete-' ~ e.id) }}"><button class="text-button danger">Nicht mehr anzeigen</button></form></div></article>{% endfor %}</div></section></main></section>{% endblock %}
