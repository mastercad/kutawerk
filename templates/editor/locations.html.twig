{% extends 'base.html.twig' %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('styles/admin.css') }}">{% endblock %}
{% block javascripts %}<script src="{{ asset('scripts/admin.js') }}?v=20260905-11" defer></script>{% endblock %}
{% block body %}<section class="admin-shell">{% include 'editor/_nav.html.twig' %}<main class="admin-content">
<header class="admin-page-header"><div><span class="eyebrow">Organisation</span><h1>Trainingsorte</h1><p>Aktuelle und zukünftige Adressen für Kurse und Proben verwalten.</p></div><button class="button editor-create" data-create-title="Trainingsort anlegen">Trainingsort anlegen</button></header>
{% for message in app.flashes('success') %}<p class="success">{{ message }}</p>{% endfor %}{% for message in app.flashes('error') %}<p class="alert">{{ message }}</p>{% endfor %}
<form method="post" class="admin-form event-form editor-panel" data-editor-form="locations" hidden><input type="hidden" name="_token" value="{{ csrf_token('location-save') }}"><input type="hidden" name="id"><input type="hidden" name="address_version_id"><h2 class="editor-form-title wide">Trainingsort anlegen</h2><label>Name des Ortes<input name="name" required placeholder="z. B. Turnhalle Lessingschule"></label><label>Straße und Hausnummer<input name="street"></label><label>Postleitzahl<input name="postal_code" inputmode="numeric"></label><label>Ort<input name="city"></label><label>Adresse gültig ab<input type="date" name="valid_from"><small>Leer lassen: gilt bereits jetzt.</small></label><label>Adresse gültig bis<input type="date" name="valid_until"><small>Leer lassen: gilt ohne Enddatum.</small></label><label class="wide">Zusätzliche Hinweise<textarea name="notes" placeholder="z. B. Eingang auf der Hofseite"></textarea></label><div class="choice-group"><label><input type="checkbox" name="active" value="1" checked><span>Dieser Trainingsort kann verwendet werden</span></label></div><div class="admin-actions wide"><button class="button">Trainingsort speichern</button><button class="button secondary editor-cancel" type="button">Abbrechen</button></div></form>
<section class="admin-list-section"><header class="list-heading"><div><h2>Vorhandene Trainingsorte</h2><p>{{ locations|length }} Orte</p></div><label class="list-search"><span>Trainingsort suchen</span><input type="search" placeholder="Name oder Ort eingeben" data-list-search=".location-record"></label></header><div class="admin-event-list">
{% for l in locations %}{% set uses=usageCounts[l.id]|default(0) %}{% set address=l.currentAddressVersion %}<article class="location-record"><div class="record-main"><span class="record-icon location-icon" aria-hidden="true">●</span><div><strong>{{ l.name }}</strong><p class="{{ not l.street or not l.postalCode ? 'incomplete-data' : '' }}">{{ l.street and l.postalCode ? l.address : 'Adresse noch nicht vollständig – bitte ergänzen' }}</p><div class="record-meta"><span class="status {{ l.active ? 'active' : 'inactive' }}">{{ l.active ? 'Aktiv' : 'Inaktiv' }}</span><span>{{ uses == 1 ? '1 aktive Trainingszeit' : uses ~ ' aktive Trainingszeiten' }}</span>{% if address and address.validUntil %}<span>Adresse gültig bis {{ address.validUntil|date('d.m.Y') }}</span>{% endif %}</div></div></div><div class="admin-actions"><button type="button" class="button secondary editor-edit" data-edit-title="Aktuelle Adresse bearbeiten" data-id="{{ l.id }}" data-address-version-id="{{ address ? address.id : '' }}" data-name="{{ l.name|e('html_attr') }}" data-street="{{ l.street|e('html_attr') }}" data-postal-code="{{ l.postalCode|e('html_attr') }}" data-city="{{ l.city|e('html_attr') }}" data-notes="{{ l.notes|e('html_attr') }}" data-valid-from="{{ address and address.validFrom ? address.validFrom|date('Y-m-d') : '' }}" data-valid-until="{{ address and address.validUntil ? address.validUntil|date('Y-m-d') : '' }}" data-active="{{ l.active ? '1' : '0' }}">Bearbeiten</button><details class="record-menu"><summary aria-label="Weitere Aktionen">•••</summary><div><button type="button" class="text-button editor-edit" data-edit-title="Neue Adresse planen" data-id="{{ l.id }}" data-address-version-id="" data-name="{{ l.name|e('html_attr') }}" data-street="" data-postal-code="" data-city="" data-notes="" data-valid-from="" data-valid-until="" data-active="{{ l.active ? '1' : '0' }}">Neue Adresse planen</button><form method="post" action="{{ path('editor_delete_location',{id:l.id}) }}" data-confirm="Der Trainingsort wird deaktiviert." data-confirm-title="Trainingsort deaktivieren?" data-confirm-action="Deaktivieren"><input type="hidden" name="_token" value="{{ csrf_token('location-delete-' ~ l.id) }}"><button class="text-button danger">Trainingsort deaktivieren</button></form></div></details></div></article>{% else %}<div class="empty-state"><h3>Noch keine Trainingsorte</h3></div>{% endfor %}
</div></section><section class="admin-list-section address-history"><header class="list-heading"><div><h2>Adresszeiträume</h2><p>Hier können auch zukünftige und abgelaufene Adressen bearbeitet werden.</p></div></header><div class="admin-event-list">{% for l in locations %}{% for v in l.addressVersions %}<article><div><strong>{{ l.name }}</strong><p>{{ v.address ?: 'Keine vollständige Adresse' }}</p><div class="record-meta"><span>{% if v.validFrom %}ab {{ v.validFrom|date('d.m.Y') }}{% else %}ohne Startdatum{% endif %}</span><span>{% if v.validUntil %}bis {{ v.validUntil|date('d.m.Y') }}{% else %}ohne Enddatum{% endif %}</span></div></div><button type="button" class="button secondary editor-edit" data-edit-title="Adresszeitraum bearbeiten" data-id="{{ l.id }}" data-address-version-id="{{ v.id }}" data-name="{{ l.name|e('html_attr') }}" data-street="{{ v.street|e('html_attr') }}" data-postal-code="{{ v.postalCode|e('html_attr') }}" data-city="{{ v.city|e('html_attr') }}" data-notes="{{ v.notes|e('html_attr') }}" data-valid-from="{{ v.validFrom ? v.validFrom|date('Y-m-d') : '' }}" data-valid-until="{{ v.validUntil ? v.validUntil|date('Y-m-d') : '' }}" data-active="{{ l.active ? '1' : '0' }}">Bearbeiten</button></article>{% endfor %}{% endfor %}</div></section></main></section>{% endblock %}
