{% extends 'base.html.twig' %}{% block stylesheets %}<link rel="stylesheet" href="{{ asset('styles/admin.css') }}">{% endblock %}{% block javascripts %}<script src="{{ asset('scripts/admin.js') }}?v=20260905-11" defer></script>{% endblock %}
{% block body %}{% set days={1:'Montag',2:'Dienstag',3:'Mittwoch',4:'Donnerstag',5:'Freitag',6:'Samstag',7:'Sonntag'} %}<section class="admin-shell">{% include 'editor/_nav.html.twig' %}<main class="admin-content"><header class="admin-page-header"><div><span class="eyebrow">Inhalte</span><h1>Trainingszeiten</h1><p>Regelmäßige Trainings einfach nach Wochentag, Uhrzeit und Ort pflegen.</p></div><button class="button editor-create" data-create-title="Trainingszeit anlegen">Trainingszeit anlegen</button></header>{% for message in app.flashes('success') %}<p class="success">{{ message }}</p>{% endfor %}{% for message in app.flashes('error') %}<p class="alert">{{ message }}</p>{% endfor %}
<form method="post" class="admin-form event-form editor-panel" data-editor-form="training" hidden><input type="hidden" name="_token" value="{{ csrf_token('training-save') }}"><input type="hidden" name="id"><input type="hidden" name="trainer_names"><h2 class="editor-form-title wide">Trainingszeit anlegen</h2><label>Welcher Kurs?<select name="course" required>{% for c in courses %}<option value="{{ c.id }}">{{ c.name }}</option>{% endfor %}</select></label><label>Wo findet das Training statt?<select name="location" required>{% for l in locations %}<option value="{{ l.id }}">{{ l.name }}</option>{% endfor %}</select></label><label>Wochentag<select name="weekday">{% for i,n in days %}<option value="{{ i }}">{{ n }}</option>{% endfor %}</select></label><label>Beginn<input type="time" name="starts_at" required></label><label>Ende<input type="time" name="ends_at" required></label><label>Tanzstil oder Schwerpunkt<input name="dance_style" placeholder="optional"></label><label>Gültig ab<input type="date" name="valid_from"><small>Leer lassen, wenn die Zeit sofort gilt.</small></label><label>Gültig bis<input type="date" name="valid_until"><small>Leer lassen, wenn es kein Enddatum gibt.</small></label><label class="wide">Hinweis für Teilnehmer<input name="notes" placeholder="optional"></label><div class="choice-group"><label><input type="checkbox" name="active" value="1" checked><span>Diese Trainingszeit auf der Webseite anzeigen</span></label></div><div class="admin-actions wide"><button class="button">Trainingszeit speichern</button><button class="button secondary editor-cancel" type="button">Abbrechen</button></div></form>
<section class="admin-list-section"><header class="list-heading"><div><h2>Wochenplan</h2><p>{{ sessions|length }} Trainingszeiten</p></div></header><div class="admin-event-list">{% for s in sessions %}<article><div class="record-main"><span class="record-date"><strong>{{ days[s.weekday]|slice(0,2) }}</strong><small>{{ s.startsAt|date('H:i') }}</small></span><div><strong>{{ s.course.name }}</strong><p>{{ days[s.weekday] }}, {{ s.startsAt|date('H:i') }}–{{ s.endsAt|date('H:i') }} Uhr · {{ s.location.name }}</p><div class="record-meta"><span class="status {{ s.active ? 'active' : 'inactive' }}">{{ s.active ? 'Sichtbar' : 'Ausgeblendet' }}</span>{% if s.danceStyle %}<span>{{ s.danceStyle }}</span>{% endif %}{% if s.validUntil %}<span>bis {{ s.validUntil|date('d.m.Y') }}</span>{% endif %}</div></div></div><div class="admin-actions"><button type="button" class="button secondary editor-edit" data-edit-title="Trainingszeit bearbeiten" data-id="{{ s.id }}" data-course="{{ s.course.id }}" data-location="{{ s.location.id }}" data-weekday="{{ s.weekday }}" data-starts-at="{{ s.startsAt|date('H:i') }}" data-ends-at="{{ s.endsAt|date('H:i') }}" data-dance-style="{{ s.danceStyle|e('html_attr') }}" data-trainer-names="{{ s.legacyTrainerNames|e('html_attr') }}" data-valid-from="{{ s.validFrom ? s.validFrom|date('Y-m-d') : '' }}" data-valid-until="{{ s.validUntil ? s.validUntil|date('Y-m-d') : '' }}" data-notes="{{ s.notes|e('html_attr') }}" data-active="{{ s.active ? '1' : '0' }}">Bearbeiten</button><form method="post" action="{{ path('editor_delete_training',{id:s.id}) }}" class="inline-form" data-confirm="Die Trainingszeit wird von der Webseite genommen." data-confirm-title="Trainingszeit ausblenden?" data-confirm-action="Nicht mehr anzeigen"><input type="hidden" name="_token" value="{{ csrf_token('training-delete-' ~ s.id) }}"><button class="text-button danger">Nicht mehr anzeigen</button></form></div></article>{% else %}<div class="empty-state"><h3>Noch keine Trainingszeiten</h3><p>Legen Sie die erste Trainingszeit an.</p></div>{% endfor %}</div></section></main></section>{% endblock %}
