{% extends 'base.html.twig' %}{% block stylesheets %}<link rel="stylesheet" href="{{ asset('styles/admin.css') }}">{% endblock %}{% block javascripts %}<script src="{{ asset('scripts/admin.js') }}?v=20260905-11" defer></script>{% endblock %}
{% block body %}<section class="admin-shell">{% include 'editor/_nav.html.twig' %}<main class="admin-content"><header class="admin-page-header"><div><span class="eyebrow">Organisation</span><h1>Kurse</h1><p>Kursangebote, Laufzeiten und verantwortliche Trainer verwalten.</p></div><button class="button editor-create" data-create-title="Kurs anlegen">Kurs anlegen</button></header>{% for message in app.flashes('success') %}<p class="success">{{ message }}</p>{% endfor %}{% for message in app.flashes('error') %}<p class="alert">{{ message }}</p>{% endfor %}
<form method="post" class="admin-form event-form editor-panel" data-editor-form="courses" hidden><input type="hidden" name="_token" value="{{ csrf_token('course-save') }}"><input type="hidden" name="id"><h2 class="editor-form-title wide">Kurs anlegen</h2><label>Name des Kurses<input name="name" required></label><label>Altersgruppe<input name="age_group"></label><label>Bereich<select name="department" required>{% for d in departments %}<option value="{{ d.id }}">{{ d.name }}</option>{% endfor %}</select></label><span></span><label>Angeboten ab<input type="date" name="valid_from"><small>Leer lassen: sofort.</small></label><label>Angeboten bis<input type="date" name="valid_until"><small>Leer lassen: ohne Enddatum.</small></label><fieldset><legend>Wer leitet diesen Kurs?</legend>{% for t in trainers %}<label class="check-row"><input type="checkbox" name="trainers[]" value="{{ t.id }}"><span>{{ t.displayName }}</span></label>{% else %}<p>Noch keine Trainer angelegt.</p>{% endfor %}</fieldset><div class="choice-group"><label><input type="checkbox" name="active" value="1" checked><span>Kurs zur Anzeige freigeben</span></label></div><div class="admin-actions wide"><button class="button">Kurs speichern</button><button class="button secondary editor-cancel" type="button">Abbrechen</button></div></form>
<section class="admin-list-section"><header class="list-heading"><div><h2>Vorhandene Kurse</h2><p>{{ courses|length }} Kurse</p></div></header><div class="admin-event-list">{% for c in courses %}<article><div class="record-main"><span class="record-icon">K</span><div><strong>{{ c.name }}</strong><p>{{ c.department.name }}{% if c.ageGroup %} · {{ c.ageGroup }}{% endif %}</p><div class="record-meta"><span class="status {{ c.validAt ? 'active' : 'inactive' }}">{{ c.validAt ? 'Aktuell angeboten' : (c.active ? 'Geplant oder abgelaufen' : 'Deaktiviert') }}</span>{% if c.validFrom %}<span>ab {{ c.validFrom|date('d.m.Y') }}</span>{% endif %}{% if c.validUntil %}<span>bis {{ c.validUntil|date('d.m.Y') }}</span>{% endif %}</div></div></div><div class="admin-actions"><button type="button" class="button secondary editor-edit" data-edit-title="Kurs bearbeiten" data-id="{{ c.id }}" data-name="{{ c.name|e('html_attr') }}" data-age-group="{{ c.ageGroup|e('html_attr') }}" data-department="{{ c.department.id }}" data-valid-from="{{ c.validFrom ? c.validFrom|date('Y-m-d') : '' }}" data-valid-until="{{ c.validUntil ? c.validUntil|date('Y-m-d') : '' }}" data-trainers="{% for t in c.trainers %}{{ t.id }}{% if not loop.last %},{% endif %}{% endfor %}" data-active="{{ c.active ? '1' : '0' }}">Bearbeiten</button><form method="post" action="{{ path('editor_delete_course',{id:c.id}) }}" class="inline-form" data-confirm="Der Kurs wird deaktiviert und anschließend nicht mehr öffentlich angeboten." data-confirm-title="Kurs deaktivieren?" data-confirm-action="Deaktivieren"><input type="hidden" name="_token" value="{{ csrf_token('course-delete-' ~ c.id) }}"><button class="text-button danger">Deaktivieren</button></form></div></article>{% endfor %}</div></section></main></section>{% endblock %}
