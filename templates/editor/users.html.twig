{% extends 'base.html.twig' %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('styles/admin.css') }}?v=20260904-8">{% endblock %}
{% block javascripts %}<script src="{{ asset('scripts/admin.js') }}?v=20260905-11" defer></script>{% endblock %}
{% block body %}<section class="admin-shell">{% include 'editor/_nav.html.twig' %}<main class="admin-content">
<header class="admin-page-header"><div><span class="eyebrow">Organisation</span><h1>Benutzer & Trainer</h1><p>Konten, Trainerprofile und Zuständigkeiten verwalten.</p></div><button class="button editor-create" data-create-title="Benutzer einladen">Benutzer anlegen</button></header>
{% for message in app.flashes('success') %}<p class="success">{{ message }}</p>{% endfor %}{% for message in app.flashes('error') %}<p class="alert">{{ message }}</p>{% endfor %}
<form method="post" enctype="multipart/form-data" class="admin-form event-form editor-panel" data-editor-form="users" hidden><input type="hidden" name="_token" value="{{ csrf_token('user-save') }}"><input type="hidden" name="id"><h2 class="editor-form-title wide">Benutzer einladen</h2>
<label>Vorname<input name="first_name" required></label><label>Nachname<input name="last_name"></label><label>E-Mail<input type="email" name="email"><small>Für reine Trainerprofile ohne Benutzerzugang optional.</small></label><span></span><label>Zugang möglich ab<input type="datetime-local" name="access_from"><small>Leer lassen: sofort.</small></label><label>Zugang möglich bis<input type="datetime-local" name="access_until"><small>Leer lassen: ohne Enddatum.</small></label>
<div class="choice-group"><label><input type="checkbox" name="active" value="1" checked><span>Profil bzw. Benutzerzugang aktiv</span></label><label><input type="checkbox" name="trainer" value="1"><span>Trainer/Kursleiter</span></label><label><input type="checkbox" name="administrator" value="1"><span>Administrator</span></label></div>
<fieldset class="wide"><legend>Öffentlicher Ansprechpartner</legend><div class="choice-group"><label><input type="checkbox" name="contact_person" value="1"><span>Auf der Kontaktseite anzeigen</span></label></div><label>Funktion<input name="contact_function" placeholder="z. B. Ansprechpartner Tanzsparte"><small>Die zugeordneten Bereiche bestimmen, bei welchen Kontaktmöglichkeiten diese Person erscheint.</small></label></fieldset>
<fieldset class="wide trainer-profile-fields"><legend>Öffentliches Trainerprofil</legend><div class="trainer-profile-editor"><div class="trainer-photo-preview" data-image-preview><img src="{{ asset('media/trainer-placeholder.svg') }}" alt="Trainerfoto"></div><label class="image-dropzone" data-file-drop><span class="upload-icon">↑</span><strong>Trainerfoto auswählen</strong><span>oder hier ablegen</span><small>Optional · JPG, PNG oder WebP · höchstens 5 MB</small><input class="visually-hidden" type="file" name="trainer_image" accept="image/jpeg,image/png,image/webp"></label></div><label>Beschreibung oder Vita<textarea name="trainer_bio" rows="7" data-auto-grow placeholder="Optional: Ausbildung, Tanzstile, Erfahrung und Aufgaben im Verein"></textarea><small>Dieser Text erscheint öffentlich auf der Trainerseite.</small></label></fieldset>
<fieldset><legend>Was darf diese Person bearbeiten?</legend>{% for value,label in permissions %}<label class="check-row"><input type="checkbox" name="permissions[]" value="{{ value }}"><span>{{ label }}</span></label>{% endfor %}</fieldset><fieldset><legend>Für welche Bereiche ist sie zuständig?</legend>{% for d in departments %}<label class="check-row"><input type="checkbox" name="departments[]" value="{{ d.id }}"><span>{{ d.name }}</span></label>{% endfor %}</fieldset><div class="admin-actions wide"><button class="button">Speichern</button><button class="button secondary editor-cancel" type="button">Abbrechen</button></div></form>
<div data-user-contact-map hidden>{% for u in users %}<span data-user-id="{{ u.id }}" data-contact-person="{{ u.contactPerson ? '1' : '0' }}" data-contact-function="{{ u.contactFunction|e('html_attr') }}"></span>{% endfor %}</div>
<section class="admin-list-section"><header class="list-heading"><div><h2>Vorhandene Konten</h2><p>{{ users|length }} Benutzer und Trainer</p></div></header><div class="admin-event-list">{% for u in users %}{% set usableAccess = u.email and u.password and u.accessAt %}<article><div class="record-main">{% if u.trainer %}<img class="record-thumbnail" src="{{ asset(u.trainerImagePath ?: 'media/trainer-placeholder.svg') }}" alt="">{% else %}<span class="record-icon">{{ u.firstName|first|upper }}{{ u.lastName|first|upper }}</span>{% endif %}<div><strong>{{ u.displayName }}</strong><p>{{ u.email ?: 'Kein Benutzerzugang' }}</p><div class="record-meta"><span class="status {{ usableAccess ? 'active' : 'inactive' }}">{{ not u.email ? 'Nur Trainerprofil' : (not u.password ? 'Zugang nicht eingerichtet' : (u.accessAt ? 'Zugang aktiv' : (u.active ? 'Geplant oder abgelaufen' : 'Deaktiviert'))) }}</span><span>{{ 'ROLE_ADMIN' in u.roles ? 'Administrator' : (u.trainer ? 'Trainer/Kursleiter' : 'Redaktion') }}</span></div></div></div><div class="admin-actions"><button type="button" class="button secondary editor-edit" data-edit-title="Benutzer bearbeiten" data-id="{{ u.id }}" data-first-name="{{ u.firstName|e('html_attr') }}" data-last-name="{{ u.lastName|e('html_attr') }}" data-email="{{ u.email }}" data-access-from="{{ u.accessFrom ? u.accessFrom|date('Y-m-d\\TH:i') : '' }}" data-access-until="{{ u.accessUntil ? u.accessUntil|date('Y-m-d\\TH:i') : '' }}" data-active="{{ u.active ? '1' : '0' }}" data-trainer="{{ u.trainer ? '1' : '0' }}" data-administrator="{{ 'ROLE_ADMIN' in u.roles ? '1' : '0' }}" data-trainer-bio="{{ u.trainerBio|e('html_attr') }}" data-image-path="{{ u.trainerImagePath|e('html_attr') }}" data-permissions="{{ u.permissions|join(',') }}" data-departments="{% for d in u.departments %}{{ d.id }}{% if not loop.last %},{% endif %}{% endfor %}">Bearbeiten</button><form method="post" action="{{ path('editor_delete_user',{id:u.id}) }}" class="inline-form" data-confirm="Der Benutzerzugang wird deaktiviert." data-confirm-title="Benutzer deaktivieren?" data-confirm-action="Deaktivieren"><input type="hidden" name="_token" value="{{ csrf_token('user-delete-' ~ u.id) }}"><button class="text-button danger">Deaktivieren</button></form></div></article>{% endfor %}</div></section>
</main></section>{% endblock %}
