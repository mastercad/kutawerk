{% extends 'base.html.twig' %}{% block stylesheets %}<link rel="stylesheet" href="{{ asset('styles/admin.css') }}?v=20260905-13">{% endblock %}{% block javascripts %}<script src="{{ asset('scripts/admin.js') }}?v=20260905-12" defer></script>{% endblock %}
{% block body %}<section class="admin-shell">{% include 'editor/_nav.html.twig' %}<main class="admin-content"><header class="admin-page-header"><div><span class="eyebrow">Inhalte</span><h1>Dokumente</h1><p>Öffentliche PDF-Dokumente, ihre Versionen und Gültigkeitszeiträume verwalten.</p></div></header>{% for message in app.flashes('success') %}<p class="success">{{ message }}</p>{% endfor %}{% for message in app.flashes('error') %}<p class="alert">{{ message }}</p>{% endfor %}
<form method="post" enctype="multipart/form-data" class="admin-form event-form editor-panel" data-editor-form="documents" hidden><input type="hidden" name="_token" value="{{ csrf_token('document-save') }}"><input type="hidden" name="id"><input type="hidden" name="document_key"><h2 class="editor-form-title wide">Neue Dokumentversion</h2><label class="wide document-upload"><span>PDF-Datei</span><input type="file" name="document_file" accept="application/pdf,.pdf"><small>Bei einer neuen Version erforderlich · PDF · höchstens 15 MB</small></label><label>Gültig ab<input type="date" name="valid_from"><small>Bei einer neuen Version wird ohne Angabe der heutige Tag verwendet.</small></label><label>Gültig bis<input type="date" name="valid_until"><small>Leer lassen: ohne Enddatum.</small></label><div class="admin-actions wide"><button class="button" type="submit">Dokumentversion speichern</button><button class="button secondary editor-cancel" type="button">Abbrechen</button></div></form>
<div class="document-admin-list">{% for key,item in catalog %}{% set current=null %}{% for version in versions[key] %}{% if current is null and version.validAt(today) %}{% set current=version %}{% endif %}{% endfor %}<section class="document-admin-card"><header><div><span>{{ item.group }}</span><h2>{{ item.title }}</h2><p>{{ item.description }}</p></div><button type="button" class="button editor-create" data-create-title="Neue Version: {{ item.title }}" data-submit-label="Neue Version speichern" data-document-key="{{ key }}">Neue Version</button></header>{% if current %}<div class="document-current"><span class="status active">Aktuell veröffentlicht</span><strong>{{ current.originalName }}</strong><small>{{ current.formattedSize }} · {% if current.validFrom %}ab {{ current.validFrom|date('d.m.Y') }}{% else %}ohne Startdatum{% endif %} · {% if current.validUntil %}bis {{ current.validUntil|date('d.m.Y') }}{% else %}ohne Enddatum{% endif %}</small><a href="{{ current.storedPath }}" target="_blank" rel="noopener">Dokument öffnen</a></div>{% else %}<p class="document-missing">Derzeit ist keine Version dieses Dokuments gültig.</p>{% endif %}<details class="document-history"><summary>Versionsverlauf ({{ versions[key]|length }})</summary><div>{% for version in versions[key] %}<article><div><strong>{{ version.originalName }}</strong><p>{{ version.formattedSize }}</p><div class="record-meta"><span>{% if version.validFrom %}ab {{ version.validFrom|date('d.m.Y') }}{% else %}ohne Startdatum{% endif %}</span><span>{% if version.validUntil %}bis {{ version.validUntil|date('d.m.Y') }}{% else %}ohne Enddatum{% endif %}</span></div></div><div class="admin-actions"><a class="button secondary" href="{{ version.storedPath }}" target="_blank" rel="noopener">Öffnen</a><button type="button" class="button secondary editor-edit" data-edit-title="Gültigkeit bearbeiten: {{ item.title }}" data-id="{{ version.id }}" data-document-key="{{ key }}" data-valid-from="{{ version.validFrom ? version.validFrom|date('Y-m-d') : '' }}" data-valid-until="{{ version.validUntil ? version.validUntil|date('Y-m-d') : '' }}">Zeitraum bearbeiten</button></div></article>{% else %}<p>Noch keine Version vorhanden.</p>{% endfor %}</div></details></section>{% endfor %}</div>
</main></section>{% endblock %}
