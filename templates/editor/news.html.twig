{% extends 'base.html.twig' %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('styles/admin.css') }}?v=20260904-5">{% endblock %}
{% block javascripts %}<script src="{{ asset('scripts/admin.js') }}?v=20260905-11" defer></script><script src="{{ asset('scripts/gallery-editor.js') }}?v=20260905-12" defer></script>{% endblock %}
{% block body %}<section class="admin-shell">{% include 'editor/_nav.html.twig' %}<main class="admin-content">
<header class="admin-page-header"><div><span class="eyebrow">Inhalte</span><h1>Neuigkeiten</h1><p>Beiträge schreiben, Bilder verwalten und kontrolliert veröffentlichen.</p></div><button class="button editor-create" data-create-title="Neue Neuigkeit erstellen">Neue Neuigkeit</button></header>
{% for message in app.flashes('success') %}<p class="success" data-success-message>{{ message }}</p>{% endfor %}{% for message in app.flashes('error') %}<p class="alert">{{ message }}</p>{% endfor %}
<form method="post" enctype="multipart/form-data" class="admin-form news-editor-form editor-panel" data-editor-form="news" hidden><input type="hidden" name="_token" value="{{ csrf_token('news-save') }}"><input type="hidden" name="id"><input type="hidden" name="content_is_html" value="0">
<header class="news-editor-heading"><div><span class="editor-step-label">Neuigkeit bearbeiten</span><h2 class="editor-form-title">Neue Neuigkeit erstellen</h2></div><p>Arbeite die vier Bereiche von oben nach unten durch. Pflichtfelder sind mit * gekennzeichnet.</p></header>
<section class="editor-section"><header class="editor-section-heading"><span>1</span><div><h3>Grundinformationen</h3><p>Überschrift, Beitragsdatum und Vorschautext festlegen.</p></div></header><div class="editor-fields news-basics"><label class="news-title-field">Überschrift *<input name="title" required maxlength="180" placeholder="Worum geht es in dieser Neuigkeit?"></label><label class="news-date-field">Datum des Beitrags *<input type="date" name="published_at" value="{{ 'now'|date('Y-m-d') }}" required></label><label class="news-summary-field">Kurzbeschreibung<textarea name="excerpt" rows="4" data-auto-grow placeholder="Text für die News-Übersicht eingeben."></textarea><small>Dieser Text erscheint in der News-Übersicht vor „Mehr lesen“.</small></label></div></section>
<section class="editor-section"><header class="editor-section-heading"><span>2</span><div><h3>Vorschaubild</h3><p>Das einzelne Titelbild für die News-Übersicht und den Beitragsanfang.</p></div></header><div class="featured-image-editor"><div class="news-image-preview" data-image-preview><img src="" alt="Vorschau des Beitragsbildes" hidden><div data-image-empty><strong>Noch kein Vorschaubild</strong><span>Das Bild kann auch später ergänzt werden.</span></div></div><label class="image-dropzone" data-file-drop><span class="upload-icon">↑</span><strong>Bild hier ablegen</strong><span>oder zum Auswählen anklicken</span><small>JPG, PNG oder WebP · höchstens 5 MB</small><input class="visually-hidden" type="file" name="image" accept="image/jpeg,image/png,image/webp"></label></div></section>
<section class="editor-section"><header class="editor-section-heading"><span>3</span><div><h3>Beitrag schreiben</h3><p>Text, einzelne Bilder und Galerien erscheinen hier so, wie sie später veröffentlicht werden.</p></div></header><section class="wysiwyg"><div class="wysiwyg-toolbar" role="toolbar" aria-label="Text formatieren"><button type="button" data-editor-command="undo">↶</button><button type="button" data-editor-command="redo">↷</button><span></span><button type="button" data-editor-command="formatBlock" data-value="p">Text</button><button type="button" data-editor-command="formatBlock" data-value="h2">Überschrift</button><button type="button" data-editor-command="bold"><strong>Fett</strong></button><button type="button" data-editor-command="italic"><em>Kursiv</em></button><button type="button" data-editor-command="insertUnorderedList">Aufzählung</button><button type="button" data-editor-command="createLink">Link</button><button type="button" data-editor-command="removeFormat">Formatierung entfernen</button><div class="emoji-control"><button type="button" data-emoji-toggle aria-expanded="false">😊 Emoji</button><div class="emoji-picker" data-emoji-picker hidden role="group" aria-label="Emoji auswählen">{% for emoji, label in {'😀':'Fröhlich','😊':'Lächeln','😂':'Lachen','🥰':'Herzlich','😍':'Begeistert','🤩':'Großartig','🥳':'Feiern','😢':'Traurig','🤔':'Nachdenken','👍':'Daumen hoch','👏':'Applaus','🙌':'Jubel','💪':'Stark','❤️':'Herz','💙':'Blaues Herz','✨':'Funkeln','🎉':'Konfetti','🎭':'Theater','💃':'Tanzen','🕺':'Tänzer','🎶':'Musik','📅':'Termin','📍':'Ort','ℹ️':'Information'} %}<button type="button" data-emoji="{{ emoji }}" title="{{ label }}" aria-label="{{ label }}">{{ emoji }}</button>{% endfor %}</div></div><span></span><button type="button" data-inline-image-add>＋ Bild</button><button type="button" class="gallery-insert-button" data-gallery-add>＋ Bildergalerie</button><input class="visually-hidden" type="file" name="content_images[]" accept="image/jpeg,image/png,image/webp" multiple data-inline-image-input></div><div class="wysiwyg-surface formatted-text" contenteditable="true" role="textbox" aria-label="Beitragstext" aria-multiline="true" data-rich-editor></div><textarea name="content" required hidden></textarea></section></section>
<section class="editor-section publishing-section"><header class="editor-section-heading"><span>4</span><div><h3>Veröffentlichung</h3><p>Lege fest, ob und in welchem Zeitraum der Beitrag sichtbar ist.</p></div></header><div class="editor-fields two-columns"><label>Auf der Webseite anzeigen ab<input type="datetime-local" name="visible_from"><small>Leer lassen: sofort nach Freigabe.</small></label><label>Auf der Webseite anzeigen bis<input type="datetime-local" name="visible_until"><small>Leer lassen: ohne Enddatum.</small></label><label class="publish-toggle wide"><input type="checkbox" name="published" value="1"><span><strong>Beitrag zur Veröffentlichung freigeben</strong><small>Ohne diese Freigabe bleibt der Beitrag ein Entwurf.</small></span></label></div></section>
<footer class="editor-savebar"><div><strong>Noch einmal prüfen</strong><span>Überschrift, Bilder und Veröffentlichung kontrollieren.</span></div><div><button class="button secondary editor-cancel" type="button">Abbrechen</button><button class="button" type="submit">Beitrag speichern</button></div></footer></form>
<section class="admin-list-section"><header class="list-heading"><div><h2>Vorhandene Neuigkeiten</h2><p>{{ posts|length }} Beiträge</p></div></header><div class="admin-event-list">
{% for post in posts %}{% set gallery=[] %}{% for image in post.galleryImages %}{% set gallery=gallery|merge([{id:image.id,path:image.imagePath,caption:image.caption,position:image.position,galleryKey:image.galleryKey}]) %}{% endfor %}
<article><div class="record-main"><div class="record-thumbnail-wrap">{% if post.imagePath %}<img class="record-thumbnail" src="{{ asset(post.imagePath) }}" alt="Vorschaubild von {{ post.title }}">{% else %}<span class="record-image-missing">Kein Vorschaubild</span>{% endif %}</div><div><strong>{{ post.title }}</strong><p>{{ post.publishedAt|date('d.m.Y') }} · {{ post.galleryImages|length }} Galeriebilder</p><div class="record-meta"><span class="status {{ post.visibleAt ? 'active' : 'inactive' }}">{{ post.visibleAt ? 'Jetzt sichtbar' : (post.published ? 'Geplant oder abgelaufen' : 'Entwurf') }}</span></div></div></div><div class="admin-actions"><a class="text-button" href="{{ path('news_article',{slug:post.slug}) }}" target="_blank">Ansehen</a><button type="button" class="button secondary editor-edit" data-edit-title="Neuigkeit bearbeiten" data-id="{{ post.id }}" data-title="{{ post.title|e('html_attr') }}" data-published-at="{{ post.publishedAt|date('Y-m-d') }}" data-visible-from="{{ post.visibleFrom ? post.visibleFrom|date('Y-m-d\\TH:i') : '' }}" data-visible-until="{{ post.visibleUntil ? post.visibleUntil|date('Y-m-d\\TH:i') : '' }}" data-image-path="{{ post.imagePath|e('html_attr') }}" data-gallery="{{ gallery|json_encode|e('html_attr') }}" data-excerpt="{{ post.excerpt|e('html_attr') }}" data-content="{{ post.content|e('html_attr') }}" data-content-is-html="{{ post.contentHtml ? '1' : '0' }}" data-published="{{ post.published ? '1' : '0' }}">Bearbeiten</button><form method="post" action="{{ path('editor_delete_news',{id:post.id}) }}" class="inline-form" data-confirm="Der Beitrag wird von der Webseite genommen." data-confirm-title="Beitrag ausblenden?" data-confirm-action="Nicht mehr anzeigen"><input type="hidden" name="_token" value="{{ csrf_token('news-delete-' ~ post.id) }}"><button class="text-button danger">Nicht mehr anzeigen</button></form></div></article>{% endfor %}
</div></section></main></section>{% endblock %}
