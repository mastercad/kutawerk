# Produktionskonfiguration für kutawerk.byte-artist.de.
# Diese Vorlage enthält keine echten Zugangsdaten.

APP_ENV=prod
APP_SECRET=CHANGE_ME
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME
MAILER_DSN=null://null
MAILER_FROM=info@kutawerk.de
KUTAWERK_DEFAULT_URI=https://kutawerk.byte-artist.de

PHP_IMAGE=ghcr.io/byte-artist/kutawerk-php
WEB_IMAGE=ghcr.io/byte-artist/kutawerk-web
IMAGE_TAG=latest

# Nur an Loopback binden; TLS und öffentlicher Zugriff laufen über den Host-nginx.
HTTP_BIND=127.0.0.1
HTTP_PORT=8098
