{% extends 'base.html.twig' %}
{% block title %}KuTaWerk – Kultur und Tanz in Freital{% endblock %}
{% block body %}
<section class="hero"><div class="hero-content"><p class="eyebrow">Kultur- und Tanzwerkstatt e.V. · Freital</p><h1>Raum für Bewegung.<br>Raum für Kultur.</h1><p>Wir bringen Menschen zusammen – auf der Tanzfläche, auf der Bühne und bei Veranstaltungen in unserer Region.</p><div class="actions"><a class="button" href="{{ path('site_events') }}">Termine entdecken</a><a class="button button-ghost" href="{{ path('site_page', {path: 'kontakt'}) }}">Kontakt aufnehmen</a></div></div></section>
<section class="section"><div class="section-heading"><p class="eyebrow">Was wir machen</p><h2>Vier Bereiche. Ein Verein.</h2></div><div class="area-grid"><a class="area-card area-dance" href="{{ path('site_page', {path: 'bereiche/tanz'}) }}"><span>01</span><h3>Tanz</h3><p>Kurse, Trainingszeiten und unser Trainerteam.</p></a><a class="area-card area-culture" href="{{ path('site_page', {path: 'bereiche/kultur'}) }}"><span>02</span><h3>Kultur</h3><p>Projekte und kulturelles Leben in Freital.</p></a><a class="area-card area-tech" href="{{ path('site_page', {path: 'bereiche/technik'}) }}"><span>03</span><h3>Technik</h3><p>Equipment und Unterstützung für Veranstaltungen.</p></a><a class="area-card area-lounge" href="{{ path('site_page', {path: 'bereiche/kuta-lounge'}) }}"><span>04</span><h3>KuTa Lounge</h3><p>Unser vielseitiger Vereins- und Veranstaltungsraum.</p></a></div></section>
<section class="section events-preview"><div class="section-heading"><p class="eyebrow">Kalender</p><h2>Demnächst im KuTaWerk</h2></div>{% include 'site/_event_list.html.twig' with {events: events} %}<a class="text-link" href="{{ path('site_events') }}">Alle Veranstaltungen ansehen →</a></section>
{% endblock %}
