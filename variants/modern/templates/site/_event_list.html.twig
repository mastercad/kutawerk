<div class="event-list">{% for event in events %}<article class="event-card"><time datetime="{{ event.date }}"><strong>{{ event.date|date('d') }}</strong><span>{{ event.date|date('m.Y') }}</span></time><div><p class="event-meta">{{ event.time }}{% if event.location %} · {{ event.location }}{% endif %}</p><h3>{{ event.title }}</h3>{% if event.description %}<p>{{ event.description }}</p>{% endif %}{% if event.link %}<a class="text-link" href="{{ event.link }}">Mehr erfahren →</a>{% endif %}</div></article>{% else %}<p class="empty-state">Zurzeit sind keine Veranstaltungen eingetragen. Schaut bald wieder vorbei.</p>{% endfor %}</div>
